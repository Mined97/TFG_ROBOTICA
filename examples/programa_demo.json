{
  "inputs": [
    {
      "id": "in_pieza_a",
      "name": "Sensor pieza A",
      "pin": 32,
      "mode": "INPUT_PULLUP",
      "activeState": "LOW"
    },
    {
      "id": "in_pieza_b",
      "name": "Sensor pieza B",
      "pin": 33,
      "mode": "INPUT_PULLUP",
      "activeState": "LOW"
    }
  ],
  "outputs": [
    {
      "id": "out_cinta",
      "name": "Cinta transportadora",
      "pin": 25,
      "initialState": 0,
      "value": 0
    }
  ],
  "programLoop": true,
  "program": [
    {
      "type": "OUT",
      "id": "out_cinta",
      "value": 1
    },
    {
      "type": "IF_INPUTS",
      "id": "in_pieza_a",
      "id2": "in_pieza_b",
      "targetBoth": 3,
      "targetOne": 5,
      "targetElse": 2
    },
    {
      "type": "POSE",
      "source": "dos sensores activos",
      "vals": [70, 110, 95, 85, 100, 80, 180],
      "delayMs": 700
    },
    {
      "type": "JUMP",
      "targetBoth": 7
    },
    {
      "type": "POSE",
      "source": "un sensor activo",
      "vals": [110, 80, 100, 95, 85, 110, 180],
      "delayMs": 700
    },
    {
      "type": "JUMP",
      "targetBoth": 7
    },
    {
      "type": "OUT",
      "id": "out_cinta",
      "value": 0
    },
    {
      "type": "PAUSE",
      "durationMs": 500
    }
  ]
}
