{
  "inputs": [
    {
      "id": "sensor_inferior",
      "name": "Sensor inferior",
      "pin": 32,
      "mode": "INPUT_PULLUP",
      "activeState": "LOW"
    },
    {
      "id": "sensor_superior",
      "name": "Sensor superior",
      "pin": 33,
      "mode": "INPUT_PULLUP",
      "activeState": "LOW"
    }
  ],
  "outputs": [
    {
      "id": "out_cinta",
      "name": "Cinta transportadora",
      "pin": 25,
      "initialState": 0,
      "value": 0
    }
  ],
  "programLoop": true,
  "program": [
    {
      "type": "OUT",
      "id": "out_cinta",
      "value": 1
    },
    {
      "type": "WAIT_IN",
      "id": "sensor_inferior",
      "state": "ACTIVE",
      "timeoutMs": 0
    },
    {
      "type": "OUT",
      "id": "out_cinta",
      "value": 0
    },
    {
      "type": "IF_INPUT",
      "id": "sensor_superior",
      "expectedState": "ACTIVE",
      "targetTrue": 7,
      "targetFalse": 5
    },
    {
      "type": "POSE",
      "source": "pieza baja",
      "vals": [110, 80, 100, 95, 85, 110, 180],
      "delayMs": 700
    },
    {
      "type": "JUMP",
      "targetBoth": 8
    },
    {
      "type": "POSE",
      "source": "pieza alta",
      "vals": [70, 110, 95, 85, 100, 80, 180],
      "delayMs": 700
    },
    {
      "type": "PAUSE",
      "durationMs": 500
    }
  ]
}
